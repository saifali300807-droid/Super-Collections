# --- Server ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/super-collection

# --- Auth ---
JWT_SECRET=super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# --- Client URL (for verification links) ---
CLIENT_URL=http://localhost:5173

# --- Razorpay (leave empty to run in DEMO payment mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- SMTP Email (leave empty => verification links print in server console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Super Collection <noreply@supercollection.com>"
